NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
# Optional: full API base (overrides BACKEND_URL + /api/v1)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_PRIVY_APP_ID=

# Phantom / injected wallet QA on localhost: copy vars into .env.local, set true to
# disable the ephemeral dev keypair fallback so only a real browser wallet can sign in.
# NEXT_PUBLIC_DISABLE_EPHEMERAL_WALLET_LOGIN=true
